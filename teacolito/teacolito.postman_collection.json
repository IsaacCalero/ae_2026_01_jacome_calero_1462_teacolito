        {
          "name": "Create Profile - User A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "    pm.test('displayName saved', function () { pm.expect(pm.response.json().displayName).to.eql(pm.environment.get('user_a_display_name')); });",
                  "} else if (pm.response.code === 409) {",
                  "    console.warn('User A already has a profile in the users microservice — nothing to do, this is expected on repeat runs.');",
                  "} else {",
                  "    throw new Error('Unexpected response creating profile for User A: ' + pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token_a}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"displayName\": \"{{user_a_display_name}}\"\n}" },
            "url": { "raw": "{{base_url}}/users", "host": ["{{base_url}}"], "path": ["users"] }
          }
        },
